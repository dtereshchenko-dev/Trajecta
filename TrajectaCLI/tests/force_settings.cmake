get_filename_component(cli_dir "${CLI}" DIRECTORY)
get_filename_component(cli_name "${CLI}" NAME)
file(MAKE_DIRECTORY "${OUTPUT_ROOT}/bin" "${OUTPUT_ROOT}/Trajecta/Trajecta/observatories")
file(COPY "${CLI}" DESTINATION "${OUTPUT_ROOT}/bin")
file(GLOB runtime_dlls "${cli_dir}/*.dll")
if(runtime_dlls)
    file(COPY ${runtime_dlls} DESTINATION "${OUTPUT_ROOT}/bin")
endif()
if(EXISTS "${cli_dir}/earth_orientation")
    file(COPY "${cli_dir}/earth_orientation" DESTINATION "${OUTPUT_ROOT}/bin")
endif()
set(CLI "${OUTPUT_ROOT}/bin/${cli_name}")
file(COPY "${DATA_DIR}/OBSCODE.dat" "${DATA_DIR}/RADCODE.dat"
    DESTINATION "${OUTPUT_ROOT}/Trajecta/Trajecta/observatories")
file(MAKE_DIRECTORY "${OUTPUT_ROOT}/Trajecta/Trajecta/earth_orientation")
foreach(name IN ITEMS earth_historic.bpc earth_latest.bpc earth_predict.bpc eopc04.62-now eopc04.cnc ET-UT.dat)
    if(EXISTS "${DATA_DIR}/earth_orientation/${name}")
        file(COPY "${DATA_DIR}/earth_orientation/${name}"
            DESTINATION "${OUTPUT_ROOT}/Trajecta/Trajecta/earth_orientation")
    endif()
endforeach()
set(ephemeris "${OUTPUT_ROOT}/Trajecta/Trajecta/ephemerides/linux_p1550p2650.440")
if(NOT EXISTS "${ephemeris}")
    file(MAKE_DIRECTORY "${OUTPUT_ROOT}/Trajecta/Trajecta/ephemerides")
    file(CREATE_LINK "${DATA_DIR}/linux_p1550p2650.440" "${ephemeris}" COPY_ON_ERROR)
endif()

function(run_cli output)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env "LOCALAPPDATA=${OUTPUT_ROOT}"
            "XDG_DATA_HOME=${OUTPUT_ROOT}" "${CLI}" ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "CLI failed (${status}): ${stdout}\n${stderr}")
    endif()
    set(${output} "${stdout}" PARENT_SCOPE)
endfunction()

set(common "${INPUT}" --weight-profile uniform --no-debias --no-sigma-clip --state-at 59200)
run_cli(default ${common})
run_cli(explicit ${common} --relativity full --earth-j2 --earth-j3 --earth-j4 --earth-pole time-varying)
foreach(result IN ITEMS default explicit)
    if(NOT "${${result}}" MATCHES "relativity=full_eih earthJ2=on earthJ3=on earthJ4=on earthPole=time-varying")
        message(FATAL_ERROR "Unexpected ${result} force settings")
    endif()
    string(REGEX MATCH "\\[StateAt\\] R [^\r\n]+" state "${${result}}")
    if(NOT state)
        message(FATAL_ERROR "Missing ${result} propagated state")
    endif()
    set(${result}_state "${state}")
endforeach()
if(NOT default_state STREQUAL explicit_state)
    message(FATAL_ERROR "Explicit defaults differ from default propagation")
endif()

run_cli(changed ${common} --relativity sun-outer --no-earth-j2 --no-earth-j3 --no-earth-j4 --earth-pole fixed-j2000)
if(NOT changed MATCHES "relativity=sun_outer_eih earthJ2=off earthJ3=off earthJ4=off earthPole=fixed-j2000")
    message(FATAL_ERROR "Changed force settings not reported")
endif()
string(REGEX MATCH "\\[StateAt\\] R [^\r\n]+" changed_state "${changed}")
if(NOT changed_state OR changed_state STREQUAL default_state)
    message(FATAL_ERROR "Changed force settings did not change the propagated state")
endif()
run_cli(off ${common} --relativity off --no-earth-j2 --earth-j2)
if(NOT off MATCHES "relativity=off earthJ2=on")
    message(FATAL_ERROR "Off mode or last-option-wins handling failed")
endif()

foreach(args IN ITEMS "--relativity;bad" "--earth-pole;bad" "--relativity")
    execute_process(COMMAND "${CLI}" ${args} RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(status EQUAL 0 OR NOT stderr MATCHES "(--relativity|--earth-pole)")
        message(FATAL_ERROR "Invalid argument was not rejected: ${args}\n${stdout}\n${stderr}")
    endif()
endforeach()
